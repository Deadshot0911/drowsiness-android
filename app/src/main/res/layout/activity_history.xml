<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121212" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SESSION HISTORY" android:textColor="#32B4FF" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/tvHistory" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="No sessions recorded yet." android:textColor="#FFFFFF" android:textSize="16sp" />
    </ScrollView>
    <Button android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp"
        android:text="BACK TO DASHBOARD" android:backgroundTint="#333333" android:textColor="#FFFFFF"/>
</LinearLayout>
